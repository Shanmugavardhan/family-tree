rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /persons/{personId} {
      allow read, write: if true;
    }
    match /relationships/{relationshipId} {
      allow read, write: if true;
    }
    match /verifications/{factId} {
      allow read, write: if true;
    }
  }
}
